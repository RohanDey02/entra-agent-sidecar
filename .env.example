# Local development only. Never commit a filled-in copy of this file.
# GKE uses a federated credential on the blueprint, not this secret.

TENANT_ID=
BLUEPRINT_APP_ID=
BLUEPRINT_CLIENT_SECRET=
AGENT_CLIENT_ID=

# Audience of Ta. The ACP Gateway sets this to the blueprint app id.
AZURE_AD_AUDIENCE=
# azp of Ta. This is the ACP Gateway app id.
ACP_GATEWAY_APP_ID=

# Delegated scope the sidecar requests for the gateway. Not /.default.
GATEWAY_SCOPE=api://<GATEWAY_APP_ID>/access_as_user
GATEWAY_BASE_URL=https://<GATEWAY_HOST>
# Expected aud of Tr. Use the gateway app id, or api://<GATEWAY_APP_ID> if that is the aud.
GATEWAY_AUDIENCE=<GATEWAY_APP_ID>
GATEWAY_PATH=/
INBOUND_SCOPE=access_as_user
